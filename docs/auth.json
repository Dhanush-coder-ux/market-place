  "components": {
    "schemas": {
      "GenerateKeySchema": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "GenerateKeySchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RefreshSchema": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "refresh_token",
          "version"
        ],
        "title": "RefreshSchema"
      },
      "RevokeSchema": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "RevokeSchema"
      },
      "UserCreateManualSchema": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "mobilenumber": {
            "type": "string",
            "title": "Mobilenumber"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "two_factor": {
            "type": "boolean",
            "title": "Two Factor",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "email",
          "mobilenumber",
          "password"
        ],
        "title": "UserCreateManualSchema"
      },
      "UserResponseSchema": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "mobilenumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mobilenumber"
          },
          "two_factor": {
            "type": "boolean",
            "title": "Two Factor"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "two_factor"
        ],
        "title": "UserResponseSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
